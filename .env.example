# ---- Cloudflare ----
# API token with these permissions (account-scoped):
#   Account > Cloudflare Tunnel        : Edit
#   Account > Access: Apps and Policies: Edit
#   Zone    > DNS                      : Edit   (optional, only for DNS records)
#   Zone    > Zone                     : Read   (optional, for the domain dropdown)
# A passkey on your Cloudflare account changes nothing here: an API token is a
# separate key and is not subject to 2FA or passkey verification.
CF_API_TOKEN=paste-your-token-here

# Account ID (Cloudflare dashboard, right-hand column, or the Zero Trust URL)
CF_ACCOUNT_ID=paste-your-account-id-here

# Optional: pin to one tunnel. Leave empty to choose it in the UI.
CF_TUNNEL_ID=

# ---- This tool ----
# Password for the web UI. Empty means no login (not recommended).
CFZT_PASSWORD=change-me
# Key used to sign session cookies. Generate one with: openssl rand -hex 32
# Leaving it empty is fine: one is generated in /data/secret.key.
CFZT_SECRET_KEY=
# How long you stay logged in, in hours
CFZT_SESSION_HOURS=12
# Set to 1 when you reach the tool over https only (secure cookie)
CFZT_SECURE_COOKIE=0
# Prefills the Host/IP field on the "new application" form
CFZT_DEFAULT_ORIGIN_HOST=192.168.1.9

# ---- Docker ----
# Port on the host
CFZT_PORT=8099
# Only needed with docker-compose.ghcr.yml: which image to pull
# CFZT_IMAGE=ghcr.io/your-github-name/cfzerotrustcontrol:latest
