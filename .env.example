# ---- Cloudflare ----
# API token met deze permissies (Account-scoped):
#   Account > Cloudflare Tunnel        : Edit
#   Account > Access: Apps and Policies: Edit
#   Zone    > DNS                      : Edit   (optioneel, alleen voor DNS-records)
#   Zone    > Zone                     : Read   (optioneel, voor de domein-dropdown)
# Een passkey op je Cloudflare-account verandert hier niets aan: een API-token
# is een losse sleutel en wordt niet door 2FA/passkey geblokkeerd.
CF_API_TOKEN=paste-your-token-here

# Account ID (Cloudflare dashboard > rechterkolom, of de URL van Zero Trust)
CF_ACCOUNT_ID=paste-your-account-id-here

# Optioneel: vastzetten op één tunnel. Leeg laten = kiezen in de UI.
CF_TUNNEL_ID=

# ---- Deze tool ----
# Wachtwoord voor de web UI. Leeg = geen login (niet aanbevolen).
CFZT_PASSWORD=verander-dit
# Sleutel voor sessiecookies. Genereer met: openssl rand -hex 32
# Leeg laten mag: er wordt er dan een gegenereerd in /data/secret.key.
CFZT_SECRET_KEY=
# Sessieduur in uren
CFZT_SESSION_HOURS=12
# Zet op 1 als je de tool alleen via https benadert (secure cookie)
CFZT_SECURE_COOKIE=0
# Handig voor de "nieuwe applicatie"-form: standaard origin-host
CFZT_DEFAULT_ORIGIN_HOST=192.168.1.9

# ---- Docker ----
# Poort op de host
CFZT_PORT=8099
# Alleen nodig bij docker-compose.ghcr.yml: welke image er gepulld wordt
# CFZT_IMAGE=ghcr.io/jouw-github-naam/cfzerotrustcontrol:latest
