# Everything in here is OPTIONAL. The container starts without a .env and asks
# for the Cloudflare token, the account ID and a password in the web UI the
# first time you open it. Values set here win over what the UI stores and are
# shown as read-only on the Settings page.

# ---- Cloudflare ----
# CF_API_TOKEN=
# CF_ACCOUNT_ID=
# CF_TUNNEL_ID=

# ---- This tool ----
# Fixed password instead of the one managed in the UI
# CF0T_PASSWORD=
# Key used to sign session cookies. Generate one with: openssl rand -hex 32
# Leave it empty and one is generated in /data/secret.key.
# CF0T_SECRET_KEY=
# Set to 1 to run without any login at all (only on a trusted network)
# CF0T_DISABLE_LOGIN=0

# ---- Docker ----
# Port on the host
CF0T_PORT=8099
# Only for docker-compose.ghcr.yml: which image to pull
# CF0T_IMAGE=ghcr.io/your-github-name/cf0t-manager:latest
